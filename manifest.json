{
  "manifest_version": 3,
  "name": "JanitorAI Card Extract",
  "version": "1.3.0",
  "description": "Adds one Extract button to JanitorAI character pages (janitorai.com and jani.com). Saves a PNG character card (V2 + V3) with both names, greetings, lorebooks and the description as Markdown with its images.",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://janitorai.com/*",
        "https://www.janitorai.com/*",
        "https://jani.com/*",
        "https://www.jani.com/*"
      ],
      "js": [
        "src/core.js",
        "src/vendor/markdown-it.js",
        "src/vendor/turndown.js",
        "src/markdown.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["<all_urls>"],
  "permissions": []
}
